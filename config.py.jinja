import os

# ── Site identity ─────────────────────────────────────────────────────────────
SITE_NAME        = {{ site_name | tojson }}
SITE_DESCRIPTION = {{ site_description | tojson }}
AUTHOR           = {{ author | tojson }}
PORT             = int(os.environ.get("PORT", 8000))
{%- if site_url %}
SITE_URL         = os.environ.get("SITE_URL", {{ site_url | tojson }})
{%- else %}
SITE_URL         = os.environ.get("SITE_URL", f"http://localhost:{PORT}")
{%- endif %}
SITE_IMAGE       = os.environ.get("SITE_IMAGE", "")  # absolute URL for og:image / twitter:image (optional)

# ── Language ──────────────────────────────────────────────────────────────────
DEFAULT_LANG    = {{ default_lang | tojson }}  # serves at /  (other langs at /{lang}/)
SUPPORTED_LANGS = {{ languages | tojson }}
POSTS_PER_PAGE  = int(os.environ.get("POSTS_PER_PAGE", 10))

# ── Feeds & code highlighting ─────────────────────────────────────────────────
RSS_ITEMS            = 20          # posts per RSS feed
PYGMENTS_STYLE_DARK  = "monokai"   # code theme in dark mode
PYGMENTS_STYLE_LIGHT = "friendly"  # code theme in light mode

# ── Navigation links per language ─────────────────────────────────────────────
NAV_LINKS = {
{%- if "es" in languages %}
    "es": [("Blog", {{ ("/" if default_lang == "es" else "/es/") | tojson }}), ("Temas", {{ ("/tags/" if default_lang == "es" else "/es/tags/") | tojson }}), ("Sobre mí", "/pages/es/about")],
{%- endif %}
{%- if "en" in languages %}
    "en": [("Blog", {{ ("/" if default_lang == "en" else "/en/") | tojson }}), ("Topics", {{ ("/tags/" if default_lang == "en" else "/en/tags/") | tojson }}), ("About", "/pages/en/about")],
{%- endif %}
}

